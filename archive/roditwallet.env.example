# RODiT Wallet Network Configuration
# Copied to ~/infra-app/roditwallet.env by bootstrap-infra-app.sh (never commit that copy).
# idcp-wallet.sh sources ~/infra-app/roditwallet.env automatically when present.

# Override the default network config to avoid rate limiting
# Uncomment one of the following:

# Lava Network (recommended for reliability)
export NEAR_NETWORK_CONFIG="mainnet-lava"

# FastNEAR (default if not set)
#export NEAR_NETWORK_CONFIG="mainnet-fastnear"

# For testnet:
#export NEAR_NETWORK_CONFIG="testnet-lava"
#export NEAR_NETWORK_CONFIG="testnet-fastnear"

# Optional: override the RODiT contract account
#export RODITCONTRACTID="genaaaa-identyclaw-com.near"

# To see all available network configs:
# near config show-connections
