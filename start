#!/bin/bash
# Compatibility wrapper for the reusable service starter.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=infra-env-helper.sh
source "$SCRIPT_DIR/infra-env-helper.sh"

SERVICE_NAME="${1:-${SERVICE_NAME:-$INFRA_START_SERVICE}}"
SERVICE_PORT="${2:-${SERVICE_PORT:-}}"

if [[ -z "$SERVICE_PORT" ]] && declare -p INFRA_API_PORTS >/dev/null 2>&1; then
    SERVICE_PORT="${INFRA_API_PORTS[$SERVICE_NAME]:-}"
fi
SERVICE_PORT="${SERVICE_PORT:-$INFRA_START_PORT}"

if [[ -z "$SERVICE_NAME" || -z "$SERVICE_PORT" ]]; then
    echo "Usage: $0 [service_name] [service_port]"
    exit 1
fi

bash "$INFRA_SERVICE_STARTER" "$SERVICE_NAME" "$SERVICE_PORT"
